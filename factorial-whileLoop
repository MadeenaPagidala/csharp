//Factorial->while-loop
using System;
namespace Program5{
    class Basic{
        public static void Main(String[] args){
            int i,fact=1;
            Console.WriteLine("Enter num(Factorial):");
            i=Convert.ToInt32(Console.ReadLine());
            while(i>0){
                fact=fact*i;
                i--;
            }
            Console.WriteLine("Factorial: {0}",fact);
        }
    }
}
